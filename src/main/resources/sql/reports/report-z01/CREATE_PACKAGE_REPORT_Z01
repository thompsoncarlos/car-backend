select DISTINCT a.activity_id,upper('activity') as type_relation,a2.activity_id  from 
phi_t_activity a 
join PHI_T_REL_ACTIVITY_PROVIDER_ACTIVITY apa on a.activity_id = apa.provider_activity_id 
